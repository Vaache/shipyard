<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>@APP_NAME@</name>
  <summary>@APP_SUMMARY@</summary>
  <developer id="io.github.@OWNER_ID@">
    <name>@DEVELOPER_NAME@</name>
  </developer>
  <description>
    <p>@APP_DESCRIPTION@</p>
    <p>Everything you do on a pull request every day, in a fast native window that keeps up with your inbox instead of a stack of browser tabs.</p>
    <ul>
      <li>Review requests, your own pull requests and everything you are involved in</li>
      <li>Conversation, review threads, commits, checks and a fast diff viewer</li>
      <li>Comment, approve, request changes and merge</li>
      <li>Repositories with a file browser and git blame, projects boards and notifications</li>
      <li>A Claude Code workspace with native chat and an embedded terminal</li>
      <li>Fix failing checks, unresolved comments and merge conflicts with Claude Code in your local clone</li>
    </ul>
    <p>Sign in with your GitHub account. Local features run git, the GitHub CLI and the Claude Code CLI that are installed on your system, inside the repositories you choose.</p>
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <url type="homepage">https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/</url>
  <url type="bugtracker">@REPO_URL@/issues</url>
  <url type="vcs-browser">@REPO_URL@</url>
  <url type="donation">@DONATE_URL@</url>
  <screenshots>
    <screenshot type="default">
      <caption>Pull request conversation with merge status and unresolved comments</caption>
      <image>https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/img/linux/pr-conversation.webp</image>
    </screenshot>
    <screenshot>
      <caption>Changed files of a pull request in the diff viewer</caption>
      <image>https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/img/linux/pr-files.webp</image>
    </screenshot>
    <screenshot>
      <caption>Claude Code chat editing a file and asking permission to run tests</caption>
      <image>https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/img/linux/claude.webp</image>
    </screenshot>
    <screenshot>
      <caption>Repository browser with file tree and rendered README</caption>
      <image>https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/img/linux/repo.webp</image>
    </screenshot>
    <screenshot>
      <caption>The light theme</caption>
      <image>https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/img/linux/light.webp</image>
    </screenshot>
  </screenshots>
  <provides>
    <binary>@BIN_NAME@</binary>
  </provides>
  <requires>
    <display_length compare="ge">900</display_length>
  </requires>
  <recommends>
    <display_length compare="ge">1280</display_length>
  </recommends>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <keywords>
    <keyword>GitHub</keyword>
    <keyword>Pull Request</keyword>
    <keyword>Code Review</keyword>
    <keyword>Git</keyword>
    <keyword>Diff</keyword>
    <keyword>Claude</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#f5f3ee</color>
    <color type="primary" scheme_preference="dark">#1f6e9e</color>
  </branding>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">moderate</content_attribute>
  </content_rating>
  <releases>
    @CURRENT_RELEASE@
    <release version="2.8.0" date="2026-10-16">
      <url type="details">https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/changelog.html#v2.8.0</url>
      <description>
        <p>Lighter sync, instant lists and git blame.</p>
        <ul>
          <li>Git blame in the repository code browser</li>
          <li>Copy short link copies owner/repo#123 of the open pull request or issue</li>
          <li>Lists open instantly from a local cache and refresh with far less traffic</li>
          <li>Large diffs, quick open and Claude replies are much faster</li>
        </ul>
      </description>
    </release>
    <release version="2.7.0" date="2026-10-15">
      <url type="details">https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/changelog.html#v2.7.0</url>
      <description>
        <p>Security and reliability hardening.</p>
        <ul>
          <li>Only http, https and mailto links open</li>
          <li>Git commands ignore repository settings that could run code</li>
          <li>Pull request pages run under a strict Content Security Policy</li>
          <li>Stopping a chat stops Claude and every tool it started</li>
        </ul>
      </description>
    </release>
    <release version="2.6.2" date="2026-10-15">
      <url type="details">https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/changelog.html#v2.6.2</url>
      <description>
        <p>A full visual pass on the Linux app in dark and light.</p>
      </description>
    </release>
    <release version="2.6.1" date="2026-10-15">
      <url type="details">https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/changelog.html#v2.6.1</url>
      <description>
        <p>An optional, pay-what-you-want donation from the main menu and Preferences.</p>
      </description>
    </release>
    <release version="2.6.0" date="2026-10-15">
      <url type="details">https://@GITHUB_OWNER@.github.io/@GITHUB_REPO@/changelog.html#v2.6.0</url>
      <description>
        <p>First release of the native Linux app, built with GTK 4 and libadwaita.</p>
      </description>
    </release>
  </releases>
</component>
