id: @APP_ID@
runtime: org.gnome.Platform
runtime-version: '47'
sdk: org.gnome.Sdk
command: @BIN_NAME@
finish-args:
  - --share=network
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
  - --filesystem=home
  - --talk-name=org.freedesktop.Flatpak
  - --talk-name=org.freedesktop.secrets
  - --talk-name=org.freedesktop.Notifications
build-options:
  build-args:
    - --share=network
  env:
    RUSTUP_HOME: /run/build/@BIN_NAME@/.rustup
    CARGO_HOME: /run/build/@BIN_NAME@/.cargo
cleanup:
  - /include
  - /lib/pkgconfig
  - /share/gir-1.0
  - /share/vala
modules:
  - name: vte
    buildsystem: meson
    config-opts:
      - -Dgtk3=false
      - -Dgtk4=true
      - -Dvapi=false
      - -Dgir=false
      - -Dglade=false
      - -Ddocs=false
      - -D_systemd=false
    sources:
      - type: git
        url: https://gitlab.gnome.org/GNOME/vte.git
        tag: 0.78.2
  - name: @BIN_NAME@
    buildsystem: simple
    build-commands:
      - curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
      - cd linux && $CARGO_HOME/bin/cargo build --release
      - install -Dm755 linux/target/release/@BIN_NAME@ /app/bin/@BIN_NAME@
      - mkdir -p /app/share && cp -r linux/dist/share/. /app/share/
    sources:
      - type: dir
        path: ../../..
        skip:
          - linux/target
          - .git
          - docs
