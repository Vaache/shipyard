<Project>
  <Import Project="$(MSBuildThisFileDirectory)Branding.props" />
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version Condition="'$(Version)' == ''">$(BrandVersion)</Version>
    <Company>$(BrandPublisher)</Company>
    <Product>$(BrandDisplayName)</Product>
    <Copyright>MIT License</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1416;MVVMTK0042;MVVMTK0045;MVVMTK0049;MVVMTK0050;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DisplayName" Value="$(BrandDisplayName)" />
    <AssemblyMetadata Include="Tagline" Value="$(BrandTagline)" />
    <AssemblyMetadata Include="AppId" Value="$(BrandAppId)" />
    <AssemblyMetadata Include="ExeName" Value="$(BrandExeName)" />
    <AssemblyMetadata Include="UrlScheme" Value="$(BrandUrlScheme)" />
    <AssemblyMetadata Include="EnvPrefix" Value="$(BrandEnvPrefix)" />
    <AssemblyMetadata Include="Publisher" Value="$(BrandPublisher)" />
    <AssemblyMetadata Include="GitHubOwner" Value="$(BrandGitHubOwner)" />
    <AssemblyMetadata Include="GitHubRepo" Value="$(BrandGitHubRepo)" />
    <AssemblyMetadata Include="DonateUrl" Value="$(BrandDonateUrl)" />
  </ItemGroup>
</Project>
