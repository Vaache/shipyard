<Window
    x:Class="PullYard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="{ThemeResource SyBarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon-64.png" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SyTextBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SyMutedBrush}" />
            </StackPanel>
        </Grid>
        <ContentControl x:Name="Host" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
    </Grid>
</Window>
