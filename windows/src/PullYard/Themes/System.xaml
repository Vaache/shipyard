<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SyWindowBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SySidebarBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SyListBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SyPanelBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SyRaisedBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="SySunkenBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SyBarBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SyLineBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="SyLineStrongBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="SyTextBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="SyMutedBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="SyDimBrush" Color="#72000000" />
            <SolidColorBrush x:Key="SyAccentBrush" Color="#FF2A8BC8" />
            <SolidColorBrush x:Key="SySkyBrush" Color="#FF1F7FB8" />
            <SolidColorBrush x:Key="SyVioletBrush" Color="#FF6B55D6" />
            <SolidColorBrush x:Key="SyCoralBrush" Color="#FFD8513F" />
            <SolidColorBrush x:Key="SyGreenBrush" Color="#FF2E8A57" />
            <SolidColorBrush x:Key="SyRedBrush" Color="#FFC2412F" />
            <SolidColorBrush x:Key="SyAmberBrush" Color="#FFB7791F" />
            <SolidColorBrush x:Key="SyTealBrush" Color="#FF23877A" />
            <SolidColorBrush x:Key="SyIndigoBrush" Color="#FF4E5BC4" />
            <SolidColorBrush x:Key="SySlateBrush" Color="#FF6B7486" />
            <SolidColorBrush x:Key="SyHoverBrush" Color="#0A1A2333" />
            <SolidColorBrush x:Key="SySelectedBrush" Color="#1A2A8BC8" />
            <Color x:Key="SyAccentColor">#FF2A8BC8</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SyWindowBrush" Color="#00000000" />
            <SolidColorBrush x:Key="SySidebarBrush" Color="#00000000" />
            <SolidColorBrush x:Key="SyListBrush" Color="#00000000" />
            <SolidColorBrush x:Key="SyPanelBrush" Color="#00000000" />
            <SolidColorBrush x:Key="SyRaisedBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SySunkenBrush" Color="#40000000" />
            <SolidColorBrush x:Key="SyBarBrush" Color="#00000000" />
            <SolidColorBrush x:Key="SyLineBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="SyLineStrongBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="SyTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SyMutedBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="SyDimBrush" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="SyAccentBrush" Color="#FF5BB8EC" />
            <SolidColorBrush x:Key="SySkyBrush" Color="#FF5BB8EC" />
            <SolidColorBrush x:Key="SyVioletBrush" Color="#FF9D8CF0" />
            <SolidColorBrush x:Key="SyCoralBrush" Color="#FFEE6F5F" />
            <SolidColorBrush x:Key="SyGreenBrush" Color="#FF5DBE8A" />
            <SolidColorBrush x:Key="SyRedBrush" Color="#FFE8746A" />
            <SolidColorBrush x:Key="SyAmberBrush" Color="#FFE8B44C" />
            <SolidColorBrush x:Key="SyTealBrush" Color="#FF56C2B0" />
            <SolidColorBrush x:Key="SyIndigoBrush" Color="#FF8C97E8" />
            <SolidColorBrush x:Key="SySlateBrush" Color="#FF939CB0" />
            <SolidColorBrush x:Key="SyHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SySelectedBrush" Color="#265BB8EC" />
            <Color x:Key="SyAccentColor">#FF5BB8EC</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SyWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SySidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyListBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SySunkenBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyLineBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SyLineStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyDimBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SyAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="SySkyBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="SyVioletBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyCoralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyGreenBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyRedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyAmberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyTealBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyIndigoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SySlateBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SySelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SyHoverBrush" Color="#00000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
